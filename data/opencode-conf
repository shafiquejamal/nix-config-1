{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "read": "allow",
    "write": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "patch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "grep": "allow"
  },
  "keybinds": {
    "input_submit": "return",
    "input_newline": "shift+return"
  },
  "mcp": {
    "mcmodding-mcp": {
      "type": "local",
      "command": ["mcmodding-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:GH_PERSONAL_ACCESS_TOKEN_READ_ORG_REPO}"
      },
      "enabled": true
    },
    "apify-business-entity": {
      "type": "remote",
      "url": "https://business-entity-mcp.apify.actor/mcp",
      "headers": {
        "Authorization": "Bearer {env:APIFY_TOKEN}"
      },
      "enabled": true
    },
    "apify": {
      "url": "https://mcp.apify.com",
      "headers": {
        "Authorization": "Bearer <env:APIFY_TOKEN>"
      },
      "enabled": true
    }
  }
}
