{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "read": "allow",
    "write": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "patch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "grep": "allow"
  },
  "keybinds": {
    "input_submit": "return",
    "input_newline": "shift+return"
  },
  "mcp": {
    "huggingface": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    },
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true
    },
    "mcmodding-mcp": {
      "type": "local",
      "command": ["mcmodding-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:GH_PERSONAL_ACCESS_TOKEN_READ_ORG_REPO}"
      },
      "enabled": true
    },
    "apify-business-entity": {
      "type": "remote",
      "url": "https://business-entity-mcp.apify.actor/mcp",
      "headers": {
        "Authorization": "Bearer {env:APIFY_TOKEN}"
      },
      "enabled": false
    },
    "apify": {
      "type": "remote",
      "url": "https://mcp.apify.com",
      "headers": {
        "Authorization": "Bearer {env:APIFY_TOKEN}"
      },
      "enabled": false
    },
    "aws-mcp": {
      "type": "local",
      "command": ["uvx", "mcp-proxy-for-aws@latest", "https://aws-mcp.us-east-1.api.aws/mcp"],
      "env": { "AWS_PROFILE": "shafiquejamal" },
      "enabled": true
    },
    "aws-knowledge": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": true
    },
    "aws-docs": {
      "type": "local",
      "command": ["uvx", "awslabs.aws-documentation-mcp-server@latest"],
      "environment": { "FASTMCP_LOG_LEVEL": "ERROR", "AWS_DOCUMENTATION_PARTITION": "aws" },
      "enabled": true
    },
    "aws-iac": {
      "type": "local",
      "command": ["uvx", "awslabs.aws-iac-mcp-server@latest"],
      "environment": { "AWS_PROFILE": "shafiquejamal", "FASTMCP_LOG_LEVEL": "ERROR" },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp"],
      "enabled": true
    }
  }
}
